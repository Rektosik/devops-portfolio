#!/usr/bin/env bash

set -euo pipefail

FORBIDDEN_REGEX="(API_KEY|SECRET_KEY|PASSWORD|DO_NOT_COMMIT)[[:space:]]*="

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [[ -z "$STAGED_FILES" ]]; then
    exit 0
fi

FOUND=0

for FILE in $STAGED_FILES; do
    if [[ -f "$FILE" ]]; then
        if grep -En "$FORBIDDEN_REGEX" "$FILE" >/dev/null 2>&1; then
            echo "Помилка pre-commit: у файлі '$FILE' виявлено потенційний секрет або маркер DO_NOT_COMMIT." >&2
            FOUND=1
        fi
    fi
done

if [[ "$FOUND" -ne 0 ]]; then
    echo "Коміт скасовано. Видаліть чутливі дані перед фіксацією змін." >&2
    exit 1
fi

exit 0
