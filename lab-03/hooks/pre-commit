set -euo pipefail

FORBIDDEN_REGEX="(api_key|secret_key|password|do_not_commit)[\"']?[[:space:]]*[:=]"

FOUND=0

while IFS= read -r -d '' FILE; do
    lines="$(git show ":$FILE" | grep -EniI "$FORBIDDEN_REGEX" | cut -d: -f1 | paste -sd, - || true)"
    if [[ -n "$lines" ]]; then
        echo "Помилка pre-commit: у файлі '$FILE' (рядки: $lines) виявлено потенційний секрет або маркер DO_NOT_COMMIT." >&2
        FOUND=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [[ "$FOUND" -ne 0 ]]; then
    echo "Коміт скасовано. Видаліть чутливі дані перед фіксацією змін." >&2
    echo "(Якщо це хибне спрацювання: git commit --no-verify)" >&2
    exit 1
fi

exit 0
